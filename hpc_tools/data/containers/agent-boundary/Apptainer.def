Bootstrap: docker
From: python@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

%labels
    org.opencontainers.image.title hpc-tools restricted agent boundary fixture
    org.opencontainers.image.description Minimal Python runtime and MCP relay without an agent, SSH, Slurm, or Munge clients
    org.hpc-tools.base.name docker.io/library/python:3.12.11-slim-bookworm
    org.hpc-tools.base.digest sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

%files
    hpc-mcp-relay /opt/hpc-tools/hpc-mcp-relay

%post
    set -eu
    chmod 0755 /opt/hpc-tools/hpc-mcp-relay
    ln -s /opt/hpc-tools/hpc-mcp-relay /usr/local/bin/hpc-mcp-relay

%environment
    export HOME=/tmp
    export PYTHONDONTWRITEBYTECODE=1

%test
    set -eu
    command -v python3 >/dev/null
    command -v hpc-mcp-relay >/dev/null
    for command in ssh scp sftp sbatch scancel squeue sacct scontrol srun salloc munge unmunge; do
        if command -v "$command" >/dev/null 2>&1; then
            echo "forbidden command present: $command" >&2
            exit 1
        fi
    done

%runscript
    exec "$@"
